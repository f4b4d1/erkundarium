{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Themengebiete",
  "description": "topics.json. Jede Karte gehört genau einem Themengebiet, jedes Themengebiet genau einem Wissensgebiet.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "domain", "icon"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "title": { "$ref": "common.schema.json#/$defs/texte" },
      "domain": {
        "description": "ID des Wissensgebiets aus domains.json. Es bestimmt die Farbe der Karte.",
        "$ref": "common.schema.json#/$defs/id"
      },
      "icon": {
        "description": "Symbol des Themengebiets als SVG.",
        "$ref": "common.schema.json#/$defs/svgDatei"
      }
    },
    "additionalProperties": false
  }
}
